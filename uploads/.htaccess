# Uploaded files are user-supplied content and must never be executed as
# scripts, no matter what extension ends up on disk. This is defense-in-depth
# on top of the MIME/extension checks in handle_upload() - it does not affect
# normal image/document serving. uploads/private/ has its own stricter
# deny-all .htaccess that layers on top of this one.
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php\d?|phtml|pl|py|cgi|sh|asp|aspx)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
Options -ExecCGI -Indexes
